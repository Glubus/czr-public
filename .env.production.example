POSTGRES_DB=zwr
POSTGRES_USER=zwr
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

PUBLIC_BASE_URL=https://zwr.example.com
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DOCS_TOKEN=replace-with-another-long-random-token
FRONTEND_URL=https://zwr.example.com
EMAIL_MODE=resend
RESEND_API_KEY=re_replace-with-a-resend-api-key
EMAIL_FROM=ZWR <accounts@zwr.example.com>
REDIS_MAXMEMORY=256mb
LEGAL_OPERATOR_NAME=Your legal name or organisation
LEGAL_CONTACT_EMAIL=privacy@zwr.example.com
LEGAL_HOST_NAME=OVHcloud

CADDY_ADDRESS=zwr.example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Container ceilings; tune from production metrics rather than removing them.
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1G
WORKER_CPU_LIMIT=0.5
WORKER_MEMORY_LIMIT=512M
WEB_CPU_LIMIT=0.5
WEB_MEMORY_LIMIT=512M
CADDY_CPU_LIMIT=0.5
CADDY_MEMORY_LIMIT=256M
POSTGRES_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=2G
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=384M
BACKUP_DIR=./backups
