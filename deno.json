{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write --allow-sys --allow-ffi src/index.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write --allow-sys --allow-ffi src/index.ts",
    "worker": "deno run --allow-net --allow-env --allow-read --allow-write --allow-sys --allow-ffi src/worker.ts",
    "check": "deno check src/index.ts src/worker.ts tests/*.ts drizzle.config.ts",
    "test": "deno test --allow-env --allow-net --allow-read --allow-write=/tmp --allow-ffi --allow-sys tests",
    "text:check": "deno run --allow-read scripts/check-text-style.ts",
    "migrate": "deno run --allow-env --allow-net --allow-read src/scripts/migrate.ts",
    "db:generate": "deno run -A npm:drizzle-kit@0.31.10 generate",
    "db:migrate": "deno run -A npm:drizzle-kit@0.31.10 migrate",
    "pp:backfill": "deno run --allow-net --allow-env --allow-read src/scripts/recalculate-performance-points.ts",
    "achievements:recalculate": "deno run --allow-net --allow-env --allow-read src/scripts/recalculate-achievements.ts",
    "benchmark": "deno run --allow-net --allow-env --allow-read --allow-write=/tmp scripts/benchmark-api.ts"
  },
  "imports": {
    "@better-auth/drizzle-adapter": "npm:@better-auth/drizzle-adapter@1.6.23",
    "@scalar/hono-api-reference": "npm:@scalar/hono-api-reference@0.11.9",
    "@std/assert": "jsr:@std/assert@1",
    "better-auth": "npm:better-auth@1.6.23",
    "better-auth/plugins": "npm:better-auth@1.6.23/plugins",
    "drizzle-kit": "npm:drizzle-kit@0.31.10",
    "drizzle-orm": "npm:drizzle-orm@0.45.2",
    "drizzle-orm/pg-core": "npm:drizzle-orm@0.45.2/pg-core",
    "drizzle-orm/postgres-js": "npm:drizzle-orm@0.45.2/postgres-js",
    "effect": "npm:effect@3.22.0",
    "hono": "npm:hono@4.12.30",
    "postgres": "npm:postgres@3.4.7",
    "redis": "npm:redis@5.9.0",
    "sharp": "npm:sharp@0.35.3"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 110
  }
}
